# Supabase — Project Settings → API
# URL is safe to expose; service role key is NOT (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side Supabase, used only for Realtime broadcast subscriptions
# (live alerts / owner updates). The anon ("publishable") key is designed to
# be public; without these the site still works and falls back to polling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret between Vercel Cron and /api/cron/snapshot.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional overrides (defaults are in src/lib/balances.ts)
# POLYMARKET_ADDRESS=
# SOLANA_ADDRESS=
# SOLANA_RPC_URL=
# POLYGON_RPC_URL=
